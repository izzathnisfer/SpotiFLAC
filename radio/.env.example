# ============================================
# RADIO BOT - Environment Configuration
# ============================================

# Telegram API Credentials (from my.telegram.org)
API_ID=
API_HASH=

# NEW Radio Bot Token (from @BotFather - CREATE A NEW BOT!)
BOT_TOKEN=

# Admin Telegram User IDs (comma-separated)
# Get your ID from @userinfobot
ADMIN_IDS=

# ============================================
# Radio Server Configuration
# ============================================

# HTTP streaming port
RADIO_PORT=8766

# Maximum concurrent streaming sessions
MAX_SESSIONS=20

# Session timeout in minutes (after queue empty)
SESSION_TIMEOUT_MINUTES=10

# Audio quality (kbps)
AUDIO_BITRATE=128

# ============================================
# SpotiFLAC Integration
# ============================================

# SpotiFLAC Go API URL (for downloading tracks)
SPOTIFLAC_API_URL=http://localhost:8765

# ============================================
# Storage
# ============================================

# Audio files storage path
AUDIO_DIR=./audio

# SQLite database path
DATABASE_PATH=./radio.db

# ============================================
# Logging
# ============================================

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

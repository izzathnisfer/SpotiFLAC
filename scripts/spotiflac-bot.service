[Unit]
Description=SpotiFLAC Telegram Bot
After=network.target spotiflac-api.service
Requires=spotiflac-api.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/Projects/SpotiFLAC/bot
ExecStart=/home/ubuntu/Projects/SpotiFLAC/bot/venv/bin/python main.py
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target

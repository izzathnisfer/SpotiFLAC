# Telegram API credentials (from my.telegram.org)
API_ID=12345678
API_HASH=0123456789abcdef0123456789abcdef

# Bot token (from @BotFather)
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Cache channel ID (create private channel, add bot as admin)
# Get ID using @userinfobot or similar
CACHE_CHANNEL_ID=-1001234567890

# Allowed user IDs (comma separated, leave empty for all)
ALLOWED_USERS=123456789,987654321

# Go backend API URL
BACKEND_URL=http://127.0.0.1:8765

# Paths
DOWNLOAD_PATH=/tmp/spotiflac
DATABASE_PATH=./data/spotiflac.db

# Logging
LOG_LEVEL=INFO
